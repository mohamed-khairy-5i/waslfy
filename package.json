{
  "name": "waslfy",
  "version": "0.1.0",
  "private": true,
  "description": "Waslfy وصلّي — استخراج بيانات الشحن المصرية من رسائل واتساب، local-first",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w waslfy-parser",
    "build": "npm run build -w waslfy-parser",
    "demo": "npm run demo -w waslfy-parser",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:lint": "npm run lint -w apps/web"
  },
  "engines": {
    "node": ">=18"
  }
}
