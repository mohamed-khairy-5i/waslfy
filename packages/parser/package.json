{
  "name": "waslfy-parser",
  "version": "0.1.0",
  "description": "Extract Egyptian shipping/COD data from WhatsApp order text — zero dependencies, accuracy measured on a public corpus. استخراج بيانات الشحن المصرية من رسائل واتساب.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "demo": "tsup && node dist/cli.js"
  },
  "keywords": [
    "egypt",
    "egyptian-arabic",
    "shipping",
    "cod",
    "cash-on-delivery",
    "arabic",
    "arabic-nlp",
    "whatsapp",
    "parser",
    "extractor",
    "ecommerce",
    "logistics"
  ],
  "author": "Waslfy contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamed-khairy-5i/waslfy.git",
    "directory": "packages/parser"
  },
  "bugs": {
    "url": "https://github.com/mohamed-khairy-5i/waslfy/issues"
  },
  "homepage": "https://github.com/mohamed-khairy-5i/waslfy#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
